// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================================
// CINEMA, SALA e ENDEREÇOS
// ===================================

model Cinema {
  idCinema   Int    @id @default(autoincrement()) @map("id_cinema")
  idEndereco Int    @unique @map("id_endereco")
  nome       String
  cnpj       String @unique
  telefone   String
  email      String

  endereco     Endereco      @relation(fields: [idEndereco], references: [idEndereco])
  funcionarios Funcionario[]
  salas        Sala[]

  @@map("cinemas")
}

model Sala {
  idSala     Int    @id @default(autoincrement()) @map("id_sala")
  idCinema   Int    @map("id_cinema")
  nome       String
  capacidade Int
  tipo       String

  cinema   Cinema    @relation(fields: [idCinema], references: [idCinema])
  assentos Assento[]
  sessaos  Sessao[]

  @@map("salas")
}

model Endereco {
  idEndereco Int    @id @default(autoincrement()) @map("id_endereco")
  logradouro String
  numero     String
  bairro     String
  cidade     String
  estado     String
  cep        String

  cinema Cinema?

  @@map("enderecos")
}

// =======================
// USUÁRIOS E FUNCIONÁRIOS
// =======================

enum Role {
  ADMIN
  USER
}

model Usuario {
  idUsuario      Int      @id @default(autoincrement()) @map("id_usuario")
  nome           String
  email          String   @unique
  senha          String
  cpf            String   @unique
  telefone       String
  dataNascimento DateTime @map("data_nascimento")
  role           Role     @default(USER)

  funcionario Funcionario?
  ingressos   Ingresso[]
  pedidos     Pedido[]
  avaliacao   Avaliacao[]

  @@map("usuarios")
}

model Funcionario {
  idFuncionario   Int      @id @default(autoincrement()) @map("id_funcionario")
  idUsuario       Int      @unique @map("id_usuario")
  idCinema        Int      @map("id_cinema")
  nome            String
  email           String
  cpf             String
  telefone        String
  cargo           String
  dataContratacao DateTime @map("data_contratacao")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  cinema  Cinema  @relation(fields: [idCinema], references: [idCinema])

  @@map("funcionarios")
}

// =======================
//FILME
// =======================

model Filme {
  idFilme                 Int      @id @default(autoincrement()) @map("id_filme")
  titulo                  String
  sinopse                 String
  duracao                 DateTime
  classificacaoIndicativa Int      @map("classificacao_indicativa")
  genero                  String
  dataLancamento          DateTime @map("data_lancamento")

  sessaos   Sessao[]
  avaliacao Avaliacao[]
}

// =======================
// INGRESSOS, ASSENTOS, PEDIDOS E SESSÕES
// =======================

model Ingresso {
  idIngresso  Int      @id @default(autoincrement()) @map("id_ingresso")
  idSessao    Int      @map("id_sessao")
  idUsuario   Int      @map("id_usuario")
  idAssento   Int      @map("id_assento")
  idPedido    Int      @map("id_pedido")
  tipo        String
  preco       Int
  status      String
  dataEmissao DateTime @map("data_emissao")

  sessao  Sessao  @relation(fields: [idSessao], references: [idSessao])
  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  assento Assento @relation(fields: [idAssento], references: [idAssento])
  pedido  Pedido  @relation(fields: [idPedido], references: [idPedido])

  @@map("ingressos")
}

model Assento {
  idAssento Int    @id @default(autoincrement()) @map("id_assento")
  idSala    Int    @map("id_sala")
  numero    String
  fila      String
  tipo      String

  sala      Sala       @relation(fields: [idSala], references: [idSala])
  ingressos Ingresso[]

  @@map("assentos")
}

model Pedido {
  idPedido   Int      @id @default(autoincrement()) @map("id_pedido")
  idUsuario  Int      @map("id_usuario")
  total      Int
  status     String
  dataPedido DateTime @map("data_pedido")

  usuario    Usuario      @relation(fields: [idUsuario], references: [idUsuario])
  ingressos  Ingresso[]
  itemPedido ItemPedido[]
  pagamento  Pagamento?

  @@map("pedidos")
}

model Sessao {
  idSessao  Int      @id @default(autoincrement()) @map("id_sessao")
  idSala    Int      @map("id_sala")
  idFilme   Int      @map("id_filme")
  dataHora  DateTime @map("data_hora")
  idioma    String
  formato   String
  precoBase Int      @map("preco_base")

  sala      Sala       @relation(fields: [idSala], references: [idSala])
  filme     Filme      @relation(fields: [idFilme], references: [idFilme])
  ingressos Ingresso[]

  @@map("sessoes")
}

// =======================
// ITEM PEDIDO, PAGAMENTO, PRODUTO E AVALIAÇÃO
// =======================

model Produto {
  idProduto Int    @id @default(autoincrement()) @map("id_produto")
  nome      String
  descricao String
  preco     Float
  estoque   Int
  categoria String

  itensPedido ItemPedido[]

  @@map("produtos")
}

model ItemPedido {
  idItemPedido  Int   @id @default(autoincrement()) @map("id_item_pedido")
  idPedido      Int   @map("id_pedido")
  idProduto     Int   @map("id_produto")
  quantidade    Int
  precoUnitario Float
  Subtotal      Float

  pedido  Pedido  @relation(fields: [idPedido], references: [idPedido])
  produto Produto @relation(fields: [idProduto], references: [idProduto])
}

model Pagamento {
  idPagamento    Int      @id @default(autoincrement()) @map("id_pagamento")
  idPedido       Int      @unique @map("id_pedido")
  formaPagamento String
  valor          Float
  status         String
  dataPagamento  DateTime @map("data_pagamento")

  pedido Pedido @relation(fields: [idPedido], references: [idPedido])
}

model Avaliacao {
  idAvaliacao    Int      @id @default(autoincrement()) @map("id_avaliacao")
  idUsuario      Int      @unique @map("id_usuario")
  idFilme        Int      @map("id_filme")
  nota           Float
  comentario     String
  data_avaliacao DateTime

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  filme   Filme   @relation(fields: [idFilme], references: [idFilme])
}
